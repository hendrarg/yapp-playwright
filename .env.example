TESTMAIL_API_KEY=
TESTMAIL_NAMESPACE=
# Optional: where OTP codes are read from — `auto` (testmail.app, then the
# otp_codes table), `testmail` (no fallback), or `db` (skip testmail entirely;
# use while the testmail 100 emails/month quota is exhausted).
# The `db` and `auto` fallback paths need the PSQL_* values below.
# YAPP_OTP_SOURCE=auto
YAPP_BASE_URL=https://yapp-dev.yapp.ink/
YAPP_CREATORS_BASE_URL=https://creators-dev.yapp.ink/
YAPP_API_BASE_URL=https://staging.yapp.ink/
# Token1: creator hendrarg — creatorAuthTest and creator-side API seeding. Refreshed via OTP
# with YAPP_CREATOR_LOGIN_EMAIL (code read from otp_codes): npm run token:refresh -- creator.
# Owners are checked by JWT uuid (npm run token:inspect). Never commit a real value.
YAPP_TEST_ACCESS_TOKEN=
YAPP_CREATOR_LOGIN_EMAIL=
# QA buyer anthony_mosciski — authTest. Refreshed via OTP against
# {TESTMAIL_NAMESPACE}.qa@inbox.testmail.app: npm run token:refresh -- qa.
YAPP_TEST_ACCESS_TOKEN_BUYER=
# Token2: Sundanese — creator-post seeding and second-account flows
# (testmail {namespace}.sdet@inbox.testmail.app): npm run token:refresh -- sundanese.
YAPP_TEST_ACCESS_TOKEN_2=
# Account injected into the MCP Playwright browser session: creator (default, token1),
# buyer, sundanese (token2), or guest (start unauthenticated).
# YAPP_MCP_ACCOUNT=creator
PW_HEADLESS=false
PW_WORKERS=1
# Optional: override Playwright browser cache. By default the project escapes
# Cursor sandbox Temp paths and uses the stable per-user ms-playwright cache.
# YAPP_PLAYWRIGHT_BROWSERS_PATH=
# Google Sheets source for /automation <AUT-ID>.
YAPP_AUTOMATION_SHEET_ID=12ECspl722v6FUpXedXSef_A4IRRKpWOXD4lYxuLuoHM
YAPP_AUTOMATION_MAPPING_GID=1448466957
YAPP_AUTOMATION_CLARIFICATIONS_SHEET=Automation Clarifications
# Optional: AI-assisted test data (Google Gemini). When unset, content factories
# fall back to seeded Faker (deterministic per run seed).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: fixed seed to reproduce a Faker-only run exactly. Default: per-run timestamp.
# YAPP_TEST_SEED=
# Optional: replay a previously logged AI bundle for an exact AI-enabled re-run (debug only).
# YAPP_TEST_AI_BUNDLE=
# PostgreSQL dev/staging database — used by `npm run db:shell` and the OTP
# fallback (see YAPP_OTP_SOURCE). All four are required when used; never commit.
PSQL_DB_HOST=
PSQL_DB_NAME=
PSQL_DB_USER=
PSQL_DB_PASSWORD=
# Optional DB tuning.
# PSQL_DB_PORT=5432
# PSQL_DB_SSL_MODE=require
# PSQL_MAX_OPEN_CONNS=10
# PSQL_CONN_MAX_LIFETIME=
# Let the `dbFixtures` test fixture change whitelisted dev-DB rows (every change is
# restored after the test). Off unless set to 1; refuses a production-looking DB.
# YAPP_DB_FIXTURES=1
