{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/playwright-mcp.mjs"
      ],
      "env": {}
    },
    "google-sheets": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-gsheets@latest"
      ],
      "env": {
        "GSHEETS_TOOLSETS": "core,sheets"
      }
    }
  }
}
