{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".agents/runtime.md",
    ".agents/rules/*.md",
    ".agents/skills/registry.md",
    ".agents/domain-knowledge/index.md"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["node", "scripts/playwright-mcp.mjs"]
    },
    "google-sheets": {
      "type": "local",
      "command": ["npx", "-y", "mcp-gsheets@latest"],
      "environment": {
        "GSHEETS_TOOLSETS": "core,sheets,formatting,analysis",
        "GOOGLE_APPLICATION_CREDENTIALS": ".google-sheets-service-account.json",
        "GOOGLE_PROJECT_ID": "key-cistern-500713-k8"
      }
    }
  }
}
